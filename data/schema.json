{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GuardianAI Behavioural Telemetry Record",
  "type": "object",
  "required": ["session_id", "timestamp", "event_type", "metadata"],
  "properties": {
    "session_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": {
      "type": "string",
      "enum": [
        "SCREEN_SHARING_STARTED",
        "SCREEN_SHARING_STOPPED",
        "BANKING_APP_FOREGROUNDED",
        "BANKING_APP_BACKGROUNDED",
        "NEW_BENEFICIARY_ADDED",
        "HIGH_VALUE_TRANSACTION_INITIATED",
        "RAPID_APP_SWITCH",
        "COACHED_BEHAVIOUR_TRIGGERED",
        "INTERVENTION_TRIGGERED"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "not": {
        "anyOf": [
          { "required": ["password"] },
          { "required": ["otp"] },
          { "required": ["pin"] },
          { "required": ["cvv"] },
          { "required": ["account_number"] },
          { "required": ["card_number"] },
          { "required": ["screenshot"] }
        ]
      }
    }
  }
}
